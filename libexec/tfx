#!/usr/bin/env bash
# tfx — terraform 워크플로우 통합 명령 (plan / sum / apply 세션 / state 탐색)
# 구 tfplan / tfsum / tfapply 통합 (tm과 동일한 단일 명령 + 서브커맨드 구조)
set -euo pipefail

_self=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")
BINBOX_DIR=$(cd "$(dirname "$_self")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$BINBOX_DIR/lib/common.sh" || { echo "lib/common.sh not found" >&2; exit 1; }

SESSION_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/binbox/tfsession"
DEFAULT_MINUTES=15
PLAN_FILE="${TFPLAN_FILE:-tfplan}"
DESTROY_PLAN_FILE="${TFDESTROY_PLAN_FILE:-tfdestroyplan}"

usage() {
  cat <<'EOF'
tfx — terraform 워크플로우 통합 명령

사용법:
  tfx init [인자...]      # terraform init (backend/module 초기화, 인자 패스스루)
  tfx validate [인자...]  # terraform validate (인자 패스스루)
  tfx fmt [인자...]       # terraform fmt (인자 패스스루)
  tfx plan [인자...]      # terraform plan -out=<planfile> (인자 패스스루, AWS 계정 배너)
  tfx sum [모드] [파일]    # plan 요약 (tf-summarize): tree / stree / draw / md / json
  tfx session [분] [-d]   # 세션 시작 — AWS 계정 확인 후 N분 유효 (기본 15분)
                          #   기본은 apply만 허용, -d/--destroy 지정 시 destroy도 허용
  tfx apply [인자...]     # 세션 유효 + y/n 확인 후 terraform apply <planfile>
  tfx destroy [인자...]   # destroy 세션에서만: destroy plan 생성 + y/n 확인 후 apply
  tfx status              # 세션 상태 (유효하면 0, 없음/만료면 1)
  tfx end                 # 세션 즉시 종료
  tfx state               # fzf state 탐색 (preview: state show) → 선택 주소 출력 (조합용)
  tfx state list          # terraform state list 그대로 (파이프용)
  tfx state show          # fzf 선택 → terraform state show
  tfx state mv            # fzf 선택 → 새 주소 입력 → 확인 후 state mv
  tfx state rm            # fzf 다중 선택 → 확인 후 state rm
  tfx review [옵션] [root] # 여러 root를 init→plan→분류 (NOCHANGE/EXPECTED/REVIEW/ERROR)
                          #   인자 없으면 fzf 다중 선택, --all 로 전체 (backend.tf 자동 탐색)

Planfile:
  기본값은 ./tfplan. 환경변수 TFPLAN_FILE로 지정 가능. (plan/sum/apply 공유)
  destroy plan 기본값은 ./tfdestroyplan. 환경변수 TFDESTROY_PLAN_FILE로 지정 가능.

Review (기능은 tfx 안에서, 자격/변수는 assume·wenv 가 담당 — 관심사 분리):
  규칙 우선순위: 내장 기본 < <repo>/.tf-review.json < CLI 플래그
    --repo PATH          검토 리포 루트 (기본: 현재 디렉터리, env TF_REPO)
    --config PATH        규칙 설정 파일 (기본: <repo>/.tf-review.json 있으면 사용)
    --allow-paths a,b    허용 변경 path (콤마 구분, 기본: tags,tags_all,tag,tag_specifications)
    --allow-actions x,y  허용 action (콤마 구분, 기본: update)
    --match prefix|glob  path 매칭 모드 (기본: prefix)
    --all                fzf 대신 backend.tf 를 가진 모든 root 검토 (CI/비대화형)
  결과: NOCHANGE(변경 없음) / EXPECTED(규칙 내) / REVIEW(규칙 밖) / ERROR. 로그는 각 root의 .tf-review/.
  REVIEW·ERROR 가 하나라도 있으면 exit 2 (CI 게이트).
  env: PLAN_LOCK(기본 false) / PLAN_ARGS(plan 추가 인자) / INIT_RECONFIGURE(기본 true).

동작:
  - plan 파일 apply는 terraform의 yes 확인이 생략되므로 tfx가 별도 y/n 확인을 추가한다.
  - 세션은 시작 시점의 AWS 계정(STS 기준)에 묶인다. apply 시점에 계정이 다르면 거부.
  - 세션 시작 시 Account ID 뒷 4자리를 직접 입력해야 한다 (무의식적 y 연타 방지).
  - destroy는 destroy 세션(tfx session -d)에서만 가능하다. 일반 세션은 apply만 허용한다.
  - destroy는 먼저 destroy plan을 저장한 뒤, y/n 확인 후 해당 plan 파일을 apply한다.

예시:
  tfx init
  tfx validate && tfx fmt -recursive
  tfx plan && tfx sum tree
  tfx sum md plan-summary.md
  tfx session 15 && tfx apply
  tfx session 15 -d && tfx destroy
  terraform taint "$(tfx state)"
  tfx review                          # fzf로 root 골라 배치 검토
  tfx review --all                    # backend.tf 가진 전체 root
  tfx review --repo ~/infra a b       # 특정 root만
  tfx review --allow-actions update,create
EOF
}

# 어떤 AWS 계정을 대상으로 하는지 표시 (soft — 비 AWS 프로젝트/aws 미설치면 생략)
_aws_banner() {
  local ident
  if command -v aws >/dev/null 2>&1; then
    ident=$(aws sts get-caller-identity --output text --query '[Account,Arn]' 2>/dev/null || true)
    if [[ -n "$ident" ]]; then
      echo "AWS: ${AWS_PROFILE:-default} / Account $(printf '%s' "$ident" | cut -f1)" >&2
    fi
  fi
}

# --- plan (구 tfplan) ---

cmd_init() {
  need_cmd terraform "brew install terraform"
  terraform init "$@"
}

cmd_validate() {
  need_cmd terraform "brew install terraform"
  terraform validate "$@"
}

cmd_fmt() {
  need_cmd terraform "brew install terraform"
  terraform fmt "$@"
}

cmd_plan() {
  need_cmd terraform "brew install terraform"
  _aws_banner
  terraform plan -out="$PLAN_FILE" "$@"
  echo
  echo "✔ saved: $PLAN_FILE   (next: tfx sum [tree|stree|draw|md|json], apply: tfx apply; init: tfx init)"
}

# --- sum (구 tfsum) ---

cmd_sum() {
  local SUB="${1:-summary}"
  [[ $# -gt 0 ]] && shift || true

  local EXTRA_OUT=""
  case "$SUB" in
    md)
      case $# in
        0) ;;
        1)
          if [[ -f "$1" && "$(basename "$1")" == "tfplan" ]]; then
            PLAN_FILE="$1"
          else
            EXTRA_OUT="-out=$1"
          fi
          ;;
        2)
          EXTRA_OUT="-out=$1"
          PLAN_FILE="$2"
          ;;
        *)
          echo "unexpected argument: $3" >&2
          usage >&2
          exit 2
          ;;
      esac
      ;;
    *)
      if [[ $# -gt 0 && -f "$1" ]]; then
        PLAN_FILE="$1"
        shift
      fi
      if [[ $# -gt 0 ]]; then
        echo "unexpected argument: $1" >&2
        usage >&2
        exit 2
      fi
      ;;
  esac

  local FLAGS
  case "$SUB" in
    summary) FLAGS=() ;;
    tree)    FLAGS=(-tree) ;;
    stree)   FLAGS=(-separate-tree) ;;
    draw)    FLAGS=(-tree -draw) ;;
    md)      FLAGS=(-md) ;;
    json)    FLAGS=(-json) ;;
    *) echo "unknown subcommand: $SUB" >&2; usage; exit 2 ;;
  esac

  [[ -f "$PLAN_FILE" ]] || die "plan file not found: $PLAN_FILE (run 'tfx plan' first)"

  need_cmd terraform "brew install terraform"
  need_cmd tf-summarize "install tf-summarize"

  [[ -n "$EXTRA_OUT" ]] && FLAGS+=("$EXTRA_OUT")

  # ${FLAGS[@]+...}: bash 3.2(macOS 기본)의 set -u는 빈 배열 확장을 unbound로 취급
  terraform show -json "$PLAN_FILE" | tf-summarize ${FLAGS[@]+"${FLAGS[@]}"}
}

# --- apply 세션 (구 tfapply) ---

# STS 기준 실제 identity 조회 — stdout: "ACCOUNT<TAB>ARN"
_identity() {
  aws sts get-caller-identity --output text --query '[Account,Arn]' 2>/dev/null
}

_show_identity() {
  local account="$1" arn="$2" region workspace
  region="${AWS_REGION:-$(aws configure get region 2>/dev/null || true)}"
  workspace=$(terraform workspace show 2>/dev/null || true)
  echo "AWS_PROFILE: ${AWS_PROFILE:-(미설정 — default)}"
  echo "Account:     $account"
  echo "ARN:         $arn"
  echo "Region:      ${region:-(미설정)}"
  if [[ -n "$workspace" ]]; then
    echo "Workspace:   $workspace"
  fi
}

# 유효한 세션이면 session_account/session_left 설정, 아니면 die
_session_check() {
  [[ -f "$SESSION_FILE" ]] || die "apply 세션이 없습니다. 먼저 실행하세요: tfx session"
  local expires now
  expires=$(cut -f1 "$SESSION_FILE")
  session_account=$(cut -f2 "$SESSION_FILE")
  session_scope=$(cut -f3 "$SESSION_FILE")
  [[ -n "$session_scope" ]] || session_scope="apply"  # 구 형식(2필드) 호환
  now=$(date +%s)
  if (( now >= expires )); then
    rm -f "$SESSION_FILE"
    die "apply 세션이 만료되었습니다. 다시 시작하세요: tfx session"
  fi
  session_left=$(( (expires - now + 59) / 60 ))
}

cmd_session() {
  need_cmd aws "brew install awscli"
  local minutes="" scope="apply"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d|--destroy) scope="destroy"; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "알 수 없는 옵션: $1" "사용법: tfx session [분] [-d|--destroy]" ;;
      *)
        [[ -z "$minutes" ]] || die "분은 한 번만 지정하세요: $1"
        minutes="$1"; shift ;;
    esac
  done
  minutes="${minutes:-$DEFAULT_MINUTES}"
  [[ "$minutes" =~ ^[0-9]+$ && "$minutes" -ge 1 ]] || die "분은 1 이상의 숫자로 지정하세요: $minutes"

  local scope_label="apply"
  [[ "$scope" == "destroy" ]] && scope_label="apply/destroy"

  local ident account arn input
  ident=$(_identity) ||
    die "AWS 자격 증명을 확인할 수 없습니다." "assume <profile> 또는 AWS_PROFILE/SSO 로그인 상태를 확인하세요."
  account=$(printf '%s' "$ident" | cut -f1)
  arn=$(printf '%s' "$ident" | cut -f2)

  echo "${scope_label} 세션을 시작합니다:"
  _show_identity "$account" "$arn"
  echo
  read -r -p "계정 확인 — Account ID 뒷 4자리 입력: " input
  [[ "$input" == "${account: -4}" ]] || die "계정 확인 실패. 세션을 시작하지 않습니다."

  mkdir -p "$(dirname "$SESSION_FILE")"
  printf '%s\t%s\t%s\n' "$(( $(date +%s) + minutes * 60 ))" "$account" "$scope" >"$SESSION_FILE"
  echo "✓ 세션 시작됨 — ${minutes}분간 ${scope_label} 가능 (Account: $account)"
}

cmd_status() {
  if [[ ! -f "$SESSION_FILE" ]]; then
    echo "세션 없음"
    exit 1
  fi
  local expires account scope scope_label now
  expires=$(cut -f1 "$SESSION_FILE")
  account=$(cut -f2 "$SESSION_FILE")
  scope=$(cut -f3 "$SESSION_FILE")
  [[ -n "$scope" ]] || scope="apply"  # 구 형식(2필드) 호환
  scope_label="apply"
  [[ "$scope" == "destroy" ]] && scope_label="apply/destroy"
  now=$(date +%s)
  if (( now >= expires )); then
    echo "세션 만료됨 (Account: $account)"
    exit 1
  fi
  echo "세션 유효 — 약 $(( (expires - now + 59) / 60 ))분 남음 (Account: $account, ${scope_label})"
}

cmd_apply() {
  need_cmd terraform "brew install terraform"
  need_cmd aws "brew install awscli"
  _session_check

  local ident account arn
  ident=$(_identity) ||
    die "AWS 자격 증명을 확인할 수 없습니다." "assume <profile> 또는 AWS_PROFILE/SSO 로그인 상태를 확인하세요."
  account=$(printf '%s' "$ident" | cut -f1)
  arn=$(printf '%s' "$ident" | cut -f2)

  if [[ "$account" != "$session_account" ]]; then
    die "세션 계정($session_account)과 현재 계정($account)이 다릅니다." \
      "profile을 바꿨다면 세션을 다시 시작하세요: tfx session"
  fi

  [[ -f "$PLAN_FILE" ]] || die "plan file not found: $PLAN_FILE (run 'tfx plan' first)"

  _show_identity "$account" "$arn"
  echo "세션:        약 ${session_left}분 남음"
  echo
  echo "→ terraform apply $PLAN_FILE"
  confirm "plan file을 apply할까요? ($PLAN_FILE)" || { echo "취소했습니다."; exit 0; }
  exec terraform apply "$@" "$PLAN_FILE"
}

cmd_destroy() {
  need_cmd terraform "brew install terraform"
  need_cmd aws "brew install awscli"
  local arg
  for arg in "$@"; do
    case "$arg" in
      -auto-approve|-auto-approve=*)
        die "tfx destroy에서는 -auto-approve를 사용할 수 없습니다." \
          "Terraform의 최종 destroy 확인을 유지하세요."
        ;;
    esac
  done
  _session_check

  if [[ "$session_scope" != "destroy" ]]; then
    die "현재 세션은 apply 전용입니다. destroy 세션을 시작하세요: tfx session -d"
  fi

  local ident account arn
  ident=$(_identity) ||
    die "AWS 자격 증명을 확인할 수 없습니다." "assume <profile> 또는 AWS_PROFILE/SSO 로그인 상태를 확인하세요."
  account=$(printf '%s' "$ident" | cut -f1)
  arn=$(printf '%s' "$ident" | cut -f2)

  if [[ "$account" != "$session_account" ]]; then
    die "세션 계정($session_account)과 현재 계정($account)이 다릅니다." \
      "profile을 바꿨다면 세션을 다시 시작하세요: tfx session"
  fi

  _show_identity "$account" "$arn"
  echo "세션:        약 ${session_left}분 남음"
  echo
  echo "→ terraform plan -destroy -out=$DESTROY_PLAN_FILE $*"
  terraform plan -destroy -out="$DESTROY_PLAN_FILE" "$@"
  echo
  echo "✔ saved: $DESTROY_PLAN_FILE"
  confirm "destroy plan을 apply할까요? ($DESTROY_PLAN_FILE)" || { echo "취소했습니다."; exit 0; }
  echo "→ terraform apply $DESTROY_PLAN_FILE"
  exec terraform apply "$DESTROY_PLAN_FILE"
}

# --- state (신규) ---

# state 주소 목록 조회 — 비어 있거나 조회 실패 시 die
_state_list() {
  local list
  list=$(terraform state list 2>/dev/null) ||
    die "terraform state를 읽을 수 없습니다. (init/백엔드/작업 디렉토리 확인)"
  [[ -n "$list" ]] || die "state가 비어 있습니다."
  printf '%s\n' "$list"
}

# fzf로 state 주소 선택 (--multi로 다중 선택) — 취소 시 빈 출력
_state_pick() {
  local flags=()
  [[ "${1:-}" == "--multi" ]] && flags+=(-m)
  _state_list | fzf_pick ${flags[@]+"${flags[@]}"} \
    --prompt="state 선택: " \
    --preview 'terraform state show {} 2>/dev/null'
}

cmd_state() {
  need_cmd terraform "brew install terraform"
  local ssub="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  case "$ssub" in
    "")
      need_cmd fzf "brew install fzf"
      local addr
      addr=$(_state_pick)
      [[ -n "$addr" ]] || exit 0
      printf '%s\n' "$addr"
      ;;
    list)
      terraform state list "$@"
      ;;
    show)
      need_cmd fzf "brew install fzf"
      local addr
      addr=$(_state_pick)
      [[ -n "$addr" ]] || exit 0
      exec terraform state show "$addr"
      ;;
    mv)
      need_cmd fzf "brew install fzf"
      local src dest
      src=$(_state_pick)
      [[ -n "$src" ]] || exit 0
      _aws_banner
      echo "이동 대상: $src"
      read -r -p "새 주소 입력: " dest
      [[ -n "$dest" ]] || die "새 주소가 비어 있습니다."
      confirm "state mv를 실행할까요? ($src → $dest)" || { echo "취소했습니다."; exit 0; }
      terraform state mv "$src" "$dest"
      ;;
    rm)
      need_cmd fzf "brew install fzf"
      local picked addrs=()
      picked=$(_state_pick --multi)
      [[ -n "$picked" ]] || exit 0
      while IFS= read -r line; do
        [[ -n "$line" ]] && addrs+=("$line")
      done <<<"$picked"
      _aws_banner
      echo "제거 대상 (${#addrs[@]}개):"
      printf '  %s\n' "${addrs[@]}"
      confirm "위 리소스를 state에서 제거할까요? (인프라는 유지, 관리에서만 제외)" ||
        { echo "취소했습니다."; exit 0; }
      terraform state rm "${addrs[@]}"
      ;;
    *)
      echo "unknown state subcommand: $ssub" >&2
      usage >&2
      exit 2
      ;;
  esac
}

# --- review (구 tf-review 통합): 여러 root를 init→plan→분류 ---
# plan 결과가 사전 정의한 '예상 변경(규칙)'만 포함하는지 확인하고, 그 외는 REVIEW로 표시한다.
# 규칙 우선순위: 내장 기본값 < <repo>/.tf-review.json < CLI 플래그.

# 변경 분류 jq 필터 — 인자: --argjson allow_paths, --argjson allow_actions, --arg match
_review_jq() {
  cat <<'JQEOF'
def scalar_or_empty_paths:
  if . == null then []
  else [paths(scalars)]
  end;

def changed_paths($before; $after):
  (($before // {}) as $b
   | ($after // {}) as $a
   | (($b | scalar_or_empty_paths) + ($a | scalar_or_empty_paths) | unique)
   | map(. as $p | select(($b | getpath($p)? // null) != ($a | getpath($p)? // null))));

def path_text($p):
  $p | map(tostring) | join(".");

# dotted path 가 허용 패턴에 부합하는지.
#   prefix : 패턴과 같거나 "패턴." 으로 시작 (예: tags -> tags / tags.Env)
#   glob   : '*' 를 한 세그먼트 와일드카드로 해석한 prefix 매칭
def is_allowed_path($p):
  ($p | length) > 0 and
  (path_text($p) as $t
   | any($allow_paths[];
       . as $pat
       | if $match == "glob"
         then ($t | test("^" + ($pat | gsub("\\."; "\\.") | gsub("\\*"; "[^.]*")) + "(\\.|$)"))
         else ($t == $pat or ($t | startswith($pat + "."))) end));

[ .resource_changes[]
  | select((.change.actions | tostring) != "[\"no-op\"]")
  | select((.change.actions | tostring) != "[\"read\"]")
] as $changes
| if ($changes | length) == 0 then
    {status: "NOCHANGE", detail: ""}
  else
    ($changes | map(
      changed_paths(.change.before; .change.after) as $paths
      | {
          address: .address,
          actions: .change.actions,
          paths: ($paths | map(path_text(.))),
          review: (
            # action 이 허용 목록을 벗어나면 검토 대상.
            (((.change.actions - $allow_actions) | length) > 0)
            # path 필터는 in-place update 에만 의미가 있다.
            or ((.change.actions == ["update"])
                and (($paths | map(select(is_allowed_path(.) | not)) | length) > 0))
          )
        }
    )) as $items
    | ($items | map(select(.review))) as $review_items
    | {
        status: (if ($review_items | length) > 0 then "REVIEW" else "EXPECTED" end),
        detail: (
          $review_items
          | map(.address + " [" + (.actions | join(",")) + "] paths=" + ((.paths | join(",")) // ""))
          | join("; ")
        )
      }
  end
| [.status, .detail] | @tsv
JQEOF
}

# terraform 이 사용자 중단(SIGINT/SIGTERM)으로 죽었으면 배치를 즉시 정리 종료
_review_interrupted() {
  case "$1" in
    130|131|143) echo; echo "중단됨: 사용자 요청으로 종료합니다." >&2; exit 130 ;;
  esac
}

# backend.tf 가 있는 root 목록 (현재 repo 기준 상대경로)
_review_discover() {
  find . -name backend.tf -not -path '*/.terraform/*' \
    -exec dirname {} \; | sort -u | sed 's|^\./||'
}

cmd_review() {
  need_cmd terraform "brew install terraform"
  need_cmd jq "brew install jq"
  # -detailed-exitcode(2) 와 root별 실패를 rc로 직접 판정하므로 errexit 를 끈다
  # (pipefail/nounset 은 유지). 이 함수는 항상 명시적으로 exit 한다.
  set +e

  local repo="${TF_REPO:-$PWD}" config="" cli_paths="" cli_actions="" cli_match="" all=0
  local -a stack_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --repo) repo="${2:-}"; shift 2 ;;
      --repo=*) repo="${1#*=}"; shift ;;
      --config) config="${2:-}"; shift 2 ;;
      --config=*) config="${1#*=}"; shift ;;
      --allow-paths) cli_paths="${2:-}"; shift 2 ;;
      --allow-paths=*) cli_paths="${1#*=}"; shift ;;
      --allow-actions) cli_actions="${2:-}"; shift 2 ;;
      --allow-actions=*) cli_actions="${1#*=}"; shift ;;
      --match) cli_match="${2:-}"; shift 2 ;;
      --match=*) cli_match="${1#*=}"; shift ;;
      --all) all=1; shift ;;
      --) shift; while [[ $# -gt 0 ]]; do stack_args+=("$1"); shift; done ;;
      -*) die "알 수 없는 옵션: $1" "사용법: tfx review [옵션] [root ...]" ;;
      *) stack_args+=("$1"); shift ;;
    esac
  done

  [[ -d "$repo" ]] || die "리포 경로가 디렉터리가 아닙니다: $repo"
  repo="$(cd "$repo" && pwd)"
  cd "$repo" || die "cd 실패: $repo"

  # ruleset: 내장 기본 < .tf-review.json < CLI
  local allow_paths='["tags","tags_all","tag","tag_specifications"]'
  local allow_actions='["update"]'
  local match="prefix" v
  [[ -z "$config" && -f "$repo/.tf-review.json" ]] && config="$repo/.tf-review.json"
  if [[ -n "$config" ]]; then
    [[ -f "$config" ]] || die "설정 파일이 없습니다: $config"
    jq -e . "$config" >/dev/null 2>&1 || die "설정 파일 JSON 파싱 실패: $config"
    v="$(jq -c '.allow_paths // empty' "$config")";   [[ -n "$v" ]] && allow_paths="$v"
    v="$(jq -c '.allow_actions // empty' "$config")"; [[ -n "$v" ]] && allow_actions="$v"
    v="$(jq -r '.match // empty' "$config")";         [[ -n "$v" ]] && match="$v"
  fi
  [[ -n "$cli_paths" ]] && allow_paths="$(printf '%s' "$cli_paths" |
    jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0))')"
  [[ -n "$cli_actions" ]] && allow_actions="$(printf '%s' "$cli_actions" |
    jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0))')"
  [[ -n "$cli_match" ]] && match="$cli_match"
  case "$match" in prefix | glob) ;; *) die "--match 는 prefix 또는 glob 이어야 합니다: $match" ;; esac

  # 대상 root 수집: 인자 지정 > (fzf 선택 | --all 전체)
  local -a dirs=()
  local line
  if [[ ${#stack_args[@]} -gt 0 ]]; then
    local a
    for a in "${stack_args[@]}"; do
      a="${a#./}"
      [[ -f "$a/backend.tf" ]] || die "backend.tf 가 없습니다: $repo/$a"
      dirs+=("$a")
    done
  else
    local discovered
    discovered="$(_review_discover)"
    [[ -n "$discovered" ]] || die "backend.tf 를 가진 root 가 없습니다: $repo"
    if [[ "$all" -eq 1 ]]; then
      while IFS= read -r line; do [[ -n "$line" ]] && dirs+=("$line"); done <<<"$discovered"
    else
      need_cmd fzf "brew install fzf"
      local picked
      picked="$(printf '%s\n' "$discovered" |
        fzf_pick -m --prompt="review root 선택 (Tab 다중, 전체는 --all): " --preview 'ls {} 2>/dev/null')"
      [[ -n "$picked" ]] || exit 0
      while IFS= read -r line; do [[ -n "$line" ]] && dirs+=("$line"); done <<<"$picked"
    fi
  fi

  # 실행 옵션 (env 로 조정 — 구 tf-review 호환)
  local plan_lock="${PLAN_LOCK:-false}"
  local plan_args="${PLAN_ARGS:-}"
  local init_reconfigure="${INIT_RECONFIGURE:-true}"
  local out_dir_name="${OUT_DIR_NAME:-.tf-review}"

  echo "Terraform review"
  echo "REPO          : $repo"
  echo "STACKS        : ${#dirs[@]}"
  echo "RULESET       : ${config:-(defaults)}"
  echo "  allow_paths   : $allow_paths"
  echo "  allow_actions : $allow_actions"
  echo "  match         : $match"
  echo

  local jq_filter; jq_filter="$(_review_jq)"
  local -a summary=()
  local review_count=0 error_count=0 d out tf_plan rc status detail

  for d in "${dirs[@]}"; do
    echo "=========================================================="
    echo ">>> $d"
    out="$d/$out_dir_name"; tf_plan="$out_dir_name/plan.bin"
    mkdir -p "$out"
    local -a init_args=("-input=false")
    [[ "$init_reconfigure" == "true" ]] && init_args+=("-reconfigure")

    terraform -chdir="$d" init "${init_args[@]}" >"$out/init.log" 2>&1; rc=$?
    _review_interrupted "$rc"
    if [[ $rc -ne 0 ]]; then
      echo "    => ERROR (init 실패, 로그: $out/init.log)"
      summary+=("$d"$'\t'"ERROR"$'\t'"init 실패"); error_count=$((error_count + 1)); continue
    fi

    # PLAN_ARGS 는 -var-file 같은 추가 인자 escape hatch (의도적 word splitting)
    # shellcheck disable=SC2086
    terraform -chdir="$d" plan -input=false -lock="$plan_lock" -detailed-exitcode \
      $plan_args -out="$tf_plan" >"$out/plan.log" 2>&1; rc=$?
    _review_interrupted "$rc"
    if [[ $rc -eq 1 ]]; then
      echo "    => ERROR (plan 실패, 로그: $out/plan.log)"
      summary+=("$d"$'\t'"ERROR"$'\t'"plan 실패"); error_count=$((error_count + 1)); continue
    fi
    if [[ $rc -ne 0 && $rc -ne 2 ]]; then
      echo "    => ERROR (plan 실패 rc=$rc, 로그: $out/plan.log)"
      summary+=("$d"$'\t'"ERROR"$'\t'"plan 실패 rc=$rc"); error_count=$((error_count + 1)); continue
    fi

    terraform -chdir="$d" show -json "$tf_plan" >"$out/plan.json" 2>>"$out/plan.log"; rc=$?
    _review_interrupted "$rc"
    if [[ $rc -ne 0 ]]; then
      echo "    => ERROR (show -json 실패, 로그: $out/plan.log)"
      summary+=("$d"$'\t'"ERROR"$'\t'"show -json 실패"); error_count=$((error_count + 1)); continue
    fi

    line="$(jq -r --argjson allow_paths "$allow_paths" --argjson allow_actions "$allow_actions" \
      --arg match "$match" "$jq_filter" "$out/plan.json" 2>"$out/jq.log")"; rc=$?
    _review_interrupted "$rc"
    if [[ $rc -ne 0 ]]; then
      echo "    => ERROR (jq 분석 실패, 로그: $out/jq.log)"
      summary+=("$d"$'\t'"ERROR"$'\t'"jq 분석 실패"); error_count=$((error_count + 1)); continue
    fi

    status="${line%%$'\t'*}"; detail="${line#*$'\t'}"
    [[ "$status" == "$detail" ]] && detail=""
    echo "    => $status"
    if [[ "$status" == "REVIEW" ]]; then
      echo "       $detail"; review_count=$((review_count + 1))
    fi
    summary+=("$d"$'\t'"$status"$'\t'"$detail")
  done

  echo
  echo "=================== 요약 ==================="
  printf "%-34s %s\n" "DIRECTORY" "STATUS"
  echo "------------------------------------------------------------"
  local row rd rest rstatus rdetail
  for row in ${summary[@]+"${summary[@]}"}; do
    rd="${row%%$'\t'*}"; rest="${row#*$'\t'}"
    rstatus="${rest%%$'\t'*}"; rdetail="${rest#*$'\t'}"
    printf "%-34s %s\n" "$rd" "$rstatus"
    [[ "$rstatus" == "REVIEW" ]] && printf "%-34s   -> %s\n" "" "$rdetail"
  done

  echo
  echo "REVIEW: $review_count, ERROR: $error_count"
  if [[ $error_count -gt 0 || $review_count -gt 0 ]]; then
    exit 2
  fi
  exit 0
}

# --- dispatch ---

case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
  init)    shift; cmd_init "$@" ;;
  validate) shift; cmd_validate "$@" ;;
  fmt)     shift; cmd_fmt "$@" ;;
  plan)    shift; cmd_plan "$@" ;;
  sum)     shift; cmd_sum "$@" ;;
  session) shift; cmd_session "$@" ;;
  apply)   shift; cmd_apply "$@" ;;
  destroy) shift; cmd_destroy "$@" ;;
  status)  cmd_status ;;
  end)     rm -f "$SESSION_FILE"; echo "세션 종료됨" ;;
  state)   shift; cmd_state "$@" ;;
  review)  shift; cmd_review "$@" ;;
  *)
    echo "unknown subcommand: $1" >&2
    usage >&2
    exit 2
    ;;
esac
